# ==============================================================================
# BhashaSetu configuration. Copy to `.env` and edit as needed.
# ==============================================================================

# --- Server -------------------------------------------------------------------
BHASHASETU_HOST=0.0.0.0
BHASHASETU_PORT=8000
BHASHASETU_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Master switch ------------------------------------------------------------
# false -> DEMO/mock mode (instant, no heavy models, great for UI demos)
# true  -> REAL mode (uses Whisper / IndicTrans2 / TTS - requires requirements-ml.txt)
BHASHASETU_ENABLE_MODELS=false

# --- Offline behaviour --------------------------------------------------------
# When true, sets HF_HUB_OFFLINE / TRANSFORMERS_OFFLINE so nothing
# is ever fetched from the internet at runtime.
BHASHASETU_OFFLINE=false

# --- Compute ------------------------------------------------------------------
# auto | cpu | cuda
BHASHASETU_DEVICE=auto
# int8 (fast, low-RAM, CPU) | int8_float16 | float16 | float32
BHASHASETU_COMPUTE_TYPE=int8

# --- Model selection ----------------------------------------------------------
# Whisper: tiny | base | small | medium | large-v3
BHASHASETU_WHISPER_MODEL=small
# Translation backend: indictrans2 | nllb
BHASHASETU_MT_BACKEND=indictrans2
BHASHASETU_INDICTRANS_EN_INDIC=ai4bharat/indictrans2-en-indic-dist-200M
BHASHASETU_INDICTRANS_INDIC_EN=ai4bharat/indictrans2-indic-en-dist-200M
BHASHASETU_INDICTRANS_INDIC_INDIC=ai4bharat/indictrans2-indic-indic-dist-320M
BHASHASETU_NLLB_MODEL=facebook/nllb-200-distilled-600M
# TTS backend: mms | parler
BHASHASETU_TTS_BACKEND=mms

# --- Storage: ONE setting to rule them all ------------------------------------
# Set this to a drive or folder and EVERYTHING (data, models, tmp, HF/Torch
# caches) is placed under it. Accepts a bare drive letter (e.g. D) which becomes
# D:\translationService, or a full path (e.g. D:\apps\translationService).
# Leave blank for a project-local (portable/demo) layout under backend/.
BHASHASETU_BASE_DIR=D

# --- Limits (mirrors BAIF input spec) -----------------------------------------
BHASHASETU_MAX_AUDIO_MB=150
BHASHASETU_MAX_VIDEO_MB=200
BHASHASETU_MAX_DURATION_MIN=30