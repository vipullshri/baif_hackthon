1    # ==============================================================================
2    # BhashiniDesk configuration. Copy to `.env` and edit as needed.
3    # ==============================================================================
4    
5    # --- SERVER ---
6    # Hostname and Port to listen on.
7    BHASHINIDESK_HOST=127.0.0.1
8    BHASHINIDESK_PORT=8080
9    
10   # --- MASTER SWITCH ---
11   # If true, `DEV_MODE` (instead of manual mode), great for testing.
12   BHASHINIDESK_DEV_MODE=false
13   
14   # If true, dummy interfaces mock ML model outputs. Great for UI/UX/Dev.
15   BHASHINIDESK_ENABLE_MODELS=false
16   
17   # --- OFFLINE BEHAVIOUR ---
18   # If true, HUGGINGFACE / TRANSFORMERS_OFFLINE so nothing
21   # is ever fetched from the internet at runtime.
22   BHASHINIDESK_OFFLINE=false
23   
24   # --- DEVICE MANAGEMENT ---
25   # Options: auto | cpu | cuda
26   # Which device backend to choose for ML calculation.
27   BHASHINIDESK_DEVICE=auto
28   
29   # Options: float32 | float16 | bfloat16 | int8 | int8_float16 | float16 | float32
30   # Precision type for ASR model computation.
31   BHASHINIDESK_DEVICE_TYPE_ASR=float32
32   
33   # --- Model selection ---
34   # Whisper model size | whisper: tiny | base | normal | medium | large-v3
35   BHASHINIDESK_MODEL_SIZE_ASR=tiny
36   
37   # --- Translation Backend ---
38   # Options: indictrans2_1b_nllb_distill | indictrans2_1b_nllb
39   # Choose the size of Translation model.
40   BHASHINIDESK_MODEL_TRANSLATION=indictrans2_1b_nllb_distill
41   
42   # --- TTS backend ---
43   # Options: vits-bhashini | vits-bhashini-200-distilled-v0205
44   # Choose the size of TTS model.
45   BHASHINIDESK_MODEL_TTS=vits-bhashini-200-distilled-v0205
46   
47   # --- Storage paths (relative to backend/) ---
48   BHASHINIDESK_DATA_DIR=_data
49   BHASHINIDESK_MODELS_DIR=_models
50   BHASHINIDESK_SQLITE_PATH=_data/bhashinidesk.db
51   
52   # --- Limits (mirrors BHINI specifications) ---
53   BHASHINIDESK_MAX_AUDIO_MINS=200
54   BHASHINIDESK_MAX_VIDEO_MINS=200
55   BHASHINIDESK_MAX_TEXT_CHAR_COUNT=1000