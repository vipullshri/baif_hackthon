# ==============================================================================
# BhashaSetu runtime configuration template
# Copy this file to .env and uncomment only the values you want to override.
# Commented entries below show built-in defaults from app/config.py.
# ==============================================================================

# --- Deployment / storage root ------------------------------------------------
# Single storage root for data + models + tmp + caches.
# Accepts either:
#   - Bare drive letter: D      -> D:\translationService
#   - Full absolute path: D:\apps\translationService
# Leave unset for project-local layout (backend/data + ../models).
 BHASHASETU_BASE_DIR=

# --- Server -------------------------------------------------------------------
# API bind host (use 127.0.0.1 for local-only access).
 BHASHASETU_HOST=0.0.0.0

# API port.
 BHASHASETU_PORT=8000

# Comma-separated CORS allow-list.
 BHASHASETU_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Feature toggles ----------------------------------------------------------
# Master switch:
# false = demo/mock mode (no heavy ML, faster startup)
# true  = real model inference mode (requires ML dependencies/models)
 BHASHASETU_ENABLE_MODELS=false

# Offline mode:
# true  = prevent runtime internet fetches (sets HF/Transformers offline flags)
# false = allow model/download network access when needed
 BHASHASETU_OFFLINE=false

# --- Compute ------------------------------------------------------------------
# Device selection: auto | cpu | cuda
 BHASHASETU_DEVICE=auto

# Inference compute type: int8 | int8_float16 | float16 | float32
 BHASHASETU_COMPUTE_TYPE=int8

# --- ASR / translation / TTS model selection ----------------------------------
# Whisper model size: tiny | base | small | medium | large-v3
 BHASHASETU_WHISPER_MODEL=small

# ASR beam size (keep 5 for quality parity; lower values are faster but may reduce quality).
 BHASHASETU_ASR_BEAM_SIZE=5

# Enable VAD pre-filtering before ASR decode.
 BHASHASETU_ASR_VAD_FILTER=true

# CPU threads for ASR decode (0 = runtime default/auto).
 BHASHASETU_ASR_CPU_THREADS=0

# ASR decoder worker count (1+). Increase on multi-core CPUs for throughput.
 BHASHASETU_ASR_NUM_WORKERS=1

# Preload ASR model at startup to avoid first transcription cold-start.
 BHASHASETU_ASR_PRELOAD=true

# Translation backend: indictrans2 | nllb
 BHASHASETU_MT_BACKEND=indictrans2

# IndicTrans2 model IDs (used when MT backend is indictrans2).
 BHASHASETU_INDICTRANS_EN_INDIC=ai4bharat/indictrans2-en-indic-dist-200M
 BHASHASETU_INDICTRANS_INDIC_EN=ai4bharat/indictrans2-indic-en-dist-200M
 BHASHASETU_INDICTRANS_INDIC_INDIC=ai4bharat/indictrans2-indic-indic-dist-320M

# NLLB model ID (used when MT backend is nllb).
 BHASHASETU_NLLB_MODEL=facebook/nllb-200-distilled-600M

# Translation performance/quality tuning.
# Higher batch size -> faster throughput, higher memory usage.
 BHASHASETU_MT_BATCH_SIZE=8

# Beam width: higher can improve quality but is slower.
 BHASHASETU_MT_NUM_BEAMS=5

# Text-to-speech backend: mms | parler
 BHASHASETU_TTS_BACKEND=mms

# --- Hugging Face authentication ----------------------------------------------
# Required for gated repos (for example some IndicTrans2 models).
# Preferred central setting:
 BHASHASETU_HF_TOKEN=
# Fallback env vars supported by code (if above is empty):
 HF_TOKEN, HUGGING_FACE_HUB_TOKEN

# --- Input limits -------------------------------------------------------------
# Maximum upload size for audio files (MB).
 BHASHASETU_MAX_AUDIO_MB=150

# Maximum upload size for video files (MB).
 BHASHASETU_MAX_VIDEO_MB=200

# Maximum media duration in minutes.
 BHASHASETU_MAX_DURATION_MIN=30

# --- Notes: intentionally NOT configured here ---------------------------------
# These are install/build/runtime-internal knobs and should stay external:
# - BHASHASETU_TARGET_DIR, BHASHASETU_VENV_DIR, BHASHASETU_PIP_CACHE_DIR
# - BHASHASETU_TMP_DIR, BHASHASETU_ONEFILE
# - TEMP, TMP, TMPDIR, PATH